DATABASE_URL="postgresql://lvigs:lvigs@localhost:5433/lvigs_mart?schema=public"
DIRECT_URL="postgresql://lvigs:lvigs@localhost:5433/lvigs_mart?schema=public"
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Server
PORT=4000
WEB_ORIGIN="http://localhost:3000"
NODE_ENV="development"

# OTP
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN=30
DEV_OTP_LOG=true

# Firebase Admin SDK (required for phone auth)
# Option 1: Service account JSON file path
FIREBASE_SERVICE_ACCOUNT=""
# Option 2: Individual credentials (used if service account file not provided)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:4000/api/auth/google/callback"

# Apple
APPLE_CLIENT_ID=""
APPLE_TEAM_ID=""
APPLE_KEY_ID=""
APPLE_PRIVATE_KEY=""

# Payments
PAYMENT_GATEWAY="razorpay"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Object storage (S3 compatible)
S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="lvigs-mart"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Search
OPENSEARCH_URL=""

# FCM (push)
FCM_PROJECT_ID=""
FCM_CLIENT_EMAIL=""
FCM_PRIVATE_KEY=""

# Recommendation service
RECOMMENDATION_SERVICE_URL="http://localhost:8000"

# Sentry error tracking (optional)
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# AI Provider (Phase 6)
AI_PROVIDER="local"  # local | openai | anthropic
AI_API_KEY=""
AI_MODEL="gpt-3.5-turbo"
AI_TIMEOUT=30000
AI_MAX_TOKENS=2000

# Feature Flags (Phase 6)
FEATURE_AI_ASSISTANT=true
FEATURE_VOICE_SEARCH=true
FEATURE_IMAGE_SEARCH=true
FEATURE_BARCODE_SEARCH=true
FEATURE_LOYALTY=true
FEATURE_MEMBERSHIP=true
FEATURE_REFERRALS=true
FEATURE_ANALYTICS=true
FEATURE_FRAUD_DETECTION=true

# Recommendations (Phase 6)
RECOMMENDATION_ENABLED=true
RECOMMENDATION_CACHE_TTL=3600

# i18n (Phase 6)
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN

# Fraud Detection (Phase 6)
FRAUD_DETECTION_ENABLED=true
FRAUD_RISK_THRESHOLD=0.7

# Local Storage (when S3 not configured)
LOCAL_STORAGE_PATH="./uploads"