// ============================================================================

model IdempotencyKey {
  id        String   @id @default(uuid())
  key       String   @unique
  userId    String
  status    String   @default("PENDING") // PENDING | COMPLETED | FAILED
  response  Json?
  orderId   String?
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([key])
  @@index([expiresAt])
}

// ============================================================================
// PHASE 4 — SELLER REVIEW (Seller-specific reviews)
// ============================================================================

model SellerReview {
  id        String   @id @default(uuid())
  sellerId  String
  seller    Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  rating    Int
  title     String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, userId, orderId])
  @@index([sellerId])
  @@index([rating])
}

// ============================================================================
// PHASE 4 — BANNER TYPES
// ============================================================================

enum BannerType {
  HOME
  CATEGORY
  PROMOTIONAL
  FLASH_SALE
}

// ============================================================================
// PHASE 4 — OFFER TYPES
// ============================================================================

enum OfferType {
  PRODUCT
  CATEGORY
  SELLER
  FLASH_SALE
  COUPON
}

