// LVIGS Mart - PostgreSQL data model
// All UUIDs as primary keys, proper indexes, FK constraints.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
  DELIVERY_AGENT
}

enum AddressLabel {
  HOME
  WORK
  OTHER
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PACKED
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  RETURNED
}

enum PaymentMethod {
  UPI
  CARD
  NETBANKING
  WALLET
  EMI
  COD
  PAYLATER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FLAT
}

enum CouponScope {
  ALL
  CATEGORY
  PRODUCT
  SELLER
}

enum NotificationType {
  ORDER
  OFFER
  PRICE
  STOCK
  ACCOUNT
  SYSTEM
}

enum SellerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  APPROVED
  REJECTED
}

enum ReturnStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PICKUP_SCHEDULED
  PICKED_UP
  QUALITY_CHECK
  REFUND_INITIATED
  REFUNDED
  REPLACEMENT_INITIATED
  REPLACEMENT_DELIVERED
}

enum RefundStatus {
  INITIATED
  PROCESSING
  COMPLETED
  FAILED
}

enum ShipmentStatus {
  CREATED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
}

enum UserEventType {
  SEARCH
  PRODUCT_VIEW
  ADD_TO_CART
  REMOVE_FROM_CART
  WISHLIST
  PURCHASE
  REVIEW
  CATEGORY_VIEW
  BRAND_VIEW
  ORDER_CANCEL
  RETURN
}

// ============================================================================
// USERS / SESSIONS / DEVICES
// ============================================================================

model User {
  id             String    @id @default(uuid())
  role           UserRole  @default(CUSTOMER)
  mobile         String?   @unique
  email          String?   @unique
  passwordHash   String?
  name           String?
  gender         String?
  dob            DateTime?
  avatar         String?
  isActive       Boolean   @default(true)
  isBlocked      Boolean   @default(false)
  emailVerified  Boolean   @default(false)
  mobileVerified Boolean   @default(false)
  locale         String    @default("en")
  firebaseUid    String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses              UserAddress[]
  devices                UserDevice[]
  sessions               UserSession[]
  cart                   Cart?
  wishlist               Wishlist?
  orders                 Order[]
  reviews                Review[]
  notifications          Notification[]
  events                 UserEvent[]
  recommendations        Recommendation[]
  searchHistory          SearchHistory[]
  seller                 Seller?
  refunds                Refund[]
  returns                ReturnRequest[]
  coupons                Coupon[]                @relation("UserCoupons")
  ProductQuestion        ProductQuestion[]
  ProductAnswer          ProductAnswer[]
  PriceAlert             PriceAlert[]
  StockAlert             StockAlert[]
  SupportTicket          SupportTicket[]
  Referral               Referral[]
  LoyaltyAccount         LoyaltyAccount?
  NotificationPreference NotificationPreference?
  deliveryAgent          DeliveryAgent?
  sellerReviews          SellerReview[]

  @@index([role])
  @@index([createdAt])
}

model UserAddress {
  id        String       @id @default(uuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     AddressLabel @default(HOME)
  name      String
  mobile    String
  pincode   String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  country   String       @default("India")
  lat       Float?
  lng       Float?
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  orders Order[]

  @@index([userId])
  @@index([pincode])
}

model UserDevice {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fcmToken   String   @unique
  platform   String
  model      String?
  osVersion  String?
  appVersion String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken String   @unique
  userAgent    String?
  ip           String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model OtpAttempt {
  id         String    @id @default(uuid())
  mobile     String?
  email      String?
  codeHash   String
  purpose    String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, purpose])
  @@index([email, purpose])
}

// ============================================================================
// SELLERS
// ============================================================================

model Seller {
  id           String       @id @default(uuid())
  userId       String       @unique
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeName    String
  slug         String       @unique
  description  String?
  logo         String?
  banner       String?
  status       SellerStatus @default(PENDING)
  kycStatus    KycStatus    @default(NOT_STARTED)
  rating       Float        @default(0)
  ratingCount  Int          @default(0)
  productCount Int          @default(0)
  panNumber    String?
  gstNumber    String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  documents      SellerDocument[]
  bankAccount    SellerBankAccount?
  products       Product[]
  orders         Order[]
  payouts        SellerPayout[]
  returnRequests ReturnRequest[]    @relation("SellerReturnRequests")
  approvals      ProductApproval[]  @relation("SellerApprovals")
  sellerOffers   SellerOffer[]      @relation("SellerOffersList")
  commissions    SellerCommission[] @relation("SellerCommissions")
  settlements    SellerSettlement[] @relation("SellerSettlements")
  answers        ProductAnswer[]    @relation("SellerAnswers")
  balance        SellerBalance?
  reviews        SellerReview[]

  @@index([status])
  @@index([kycStatus])
}

model SellerDocument {
  id        String    @id @default(uuid())
  sellerId  String
  seller    Seller    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  type      String
  url       String
  status    KycStatus @default(SUBMITTED)
  notes     String?
  createdAt DateTime  @default(now())

  @@index([sellerId])
}

model SellerBankAccount {
  id            String   @id @default(uuid())
  sellerId      String   @unique
  seller        Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  accountName   String
  accountNumber String
  ifsc          String
  bankName      String
  upi           String?
  verified      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SellerPayout {
  id          String      @id @default(uuid())
  sellerId    String
  seller      Seller      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  amount      Float
  status      PayoutStatus @default(PENDING)
  reference   String?
  periodStart DateTime
  periodEnd   DateTime
  settledAt   DateTime?
  createdAt   DateTime    @default(now())

  @@index([sellerId])
  @@index([status])
}

// ============================================================================
// CATALOG: Categories, Brands, Products, Variants, Inventory
// ============================================================================

model Category {
  id              String     @id @default(uuid())
  slug            String     @unique
  name            String
  icon            String?
  image           String?
  parentId        String?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children        Category[] @relation("CategoryHierarchy")
  order           Int        @default(0)
  featured        Boolean    @default(false)
  isActive        Boolean    @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products Product[]

  @@index([parentId])
  @@index([featured])
}

model Brand {
  id        String   @id @default(uuid())
  slug      String   @unique
  name      String
  logo      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Warehouse {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  pincode   String
  city      String
  state     String
  lat       Float?
  lng       Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  inventory Inventory[]
}

model Product {
  id                String   @id @default(uuid())
  slug              String   @unique
  title             String
  description       String
  shortDesc         String?
  brandId           String
  brand             Brand    @relation(fields: [brandId], references: [id])
  categoryId        String
  category          Category @relation(fields: [categoryId], references: [id])
  sellerId          String
  seller            Seller   @relation(fields: [sellerId], references: [id])
  mrp               Float
  price             Float
  taxRate           Float    @default(0)
  rating            Float    @default(0)
  ratingCount       Int      @default(0)
  reviewCount       Int      @default(0)
  stock             Int      @default(0)
  lowStockThreshold Int      @default(5)
  isApproved        Boolean  @default(true)
  isActive          Boolean  @default(true)
  isBestseller      Boolean  @default(false)
  isNewArrival      Boolean  @default(false)
  isFlashDeal       Boolean  @default(false)
  fastDelivery      Boolean  @default(false)
  freeDelivery      Boolean  @default(true)
  deliveryCharge    Float    @default(0)
  warranty          String?
  returnPolicy      String?
  hsnCode           String?
  weight            Float?
  tags              String[]
  metaTitle         String?
  metaDescription   String?
  views             Int      @default(0)
  soldCount         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  variants       ProductVariant[]
  images         ProductImage[]
  videos         ProductVideo[]
  attributes     ProductAttribute[]
  inventory      Inventory[]
  reviews        Review[]
  cartItems      CartItem[]
  wishlistItems  WishlistItem[]
  orderItems     OrderItem[]
  events         UserEvent[]
  approvals      ProductApproval[]  @relation("ProductApprovals")
  sellerOffers   SellerOffer[]      @relation("ProductSellerOffers")
  questions      ProductQuestion[]  @relation("ProductQuestions")
  priceAlerts    PriceAlert[]       @relation("ProductPriceAlerts")
  stockAlerts    StockAlert[]       @relation("ProductStockAlerts")
  flashSaleItems FlashSaleProduct[] @relation("ProductFlashSaleItems")
  embedding      ProductEmbedding?
  models3d       Product3dModel[]
  arAssets       ArAsset[]
  priceHistory   PriceHistory[]

  @@index([categoryId])
  @@index([brandId])
  @@index([sellerId])
  @@index([price])
  @@index([rating])
  @@index([createdAt])
  @@index([title])
  @@index([categoryId, brandId, isActive])
  @@index([soldCount])
  @@index([isActive, isApproved])
  @@index([isBestseller])
  @@index([isNewArrival])
  @@index([isFlashDeal])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String   @unique
  color     String?
  size      String?
  material  String?
  mrp       Float
  price     Float
  stock     Int      @default(0)
  weight    Float?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductVideo {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  thumbnail String?
  duration  Int?
  createdAt DateTime @default(now())

  @@index([productId])
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  value     String

  @@index([productId])
  @@index([key, value])
}

model Inventory {
  id          String          @id @default(uuid())
  productId   String?
  variantId   String?
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])
  product     Product?        @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])
  quantity    Int             @default(0)
  reserved    Int             @default(0)
  updatedAt   DateTime        @updatedAt

  @@unique([variantId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

// ============================================================================
// CART / WISHLIST
// ============================================================================

model Cart {
  id         String   @id @default(uuid())
  userId     String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  couponCode String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]
}

model CartItem {
  id            String          @id @default(uuid())
  cartId        String
  cart          Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Int             @default(1)
  savedForLater Boolean         @default(false)
  addedAt       DateTime        @default(now())

  @@unique([cartId, productId, variantId])
  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  items WishlistItem[]
}

model WishlistItem {
  id         String   @id @default(uuid())
  wishlistId String
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  addedAt    DateTime @default(now())

  @@unique([wishlistId, productId])
  @@index([wishlistId])
  @@index([productId])
}

// ============================================================================
// COUPONS
// ============================================================================

model Coupon {
  id             String      @id @default(uuid())
  code           String      @unique
  description    String
  type           CouponType
  value          Float
  maxDiscount    Float?
  minOrder       Float       @default(0)
  scope          CouponScope @default(ALL)
  scopeIds       String[]
  expiresAt      DateTime
  usageLimit     Int?
  usagePerUser   Int?
  usedCount      Int         @default(0)
  firstOrderOnly Boolean     @default(false)
  userId         String?
  user           User?       @relation("UserCoupons", fields: [userId], references: [id])
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  usages CouponUsage[]

  @@index([code])
  @@index([isActive, expiresAt])
}

model CouponUsage {
  id        String   @id @default(uuid())
  couponId  String
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  userId    String
  orderId   String
  discount  Float
  createdAt DateTime @default(now())

  @@index([couponId])
  @@index([userId])
}

// ============================================================================
// ORDERS / PAYMENTS / SHIPMENTS
// ============================================================================

model Order {
  id               String        @id @default(uuid())
  shortId          String        @unique
  userId           String
  user             User          @relation(fields: [userId], references: [id])
  sellerId         String?
  seller           Seller?       @relation(fields: [sellerId], references: [id])
  addressId        String?
  address          UserAddress?  @relation(fields: [addressId], references: [id])
  status           OrderStatus   @default(PLACED)
  paymentMethod    PaymentMethod
  paymentStatus    PaymentStatus @default(PENDING)
  paymentId        String?
  couponCode       String?
  couponDiscount   Float         @default(0)
  itemTotal        Float
  deliveryFee      Float         @default(0)
  tax              Float         @default(0)
  total            Float
  notes            String?
  expectedDelivery DateTime?
  deliveredAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  invoiceUrl       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  items            OrderItem[]
  payment          OrderPayment?
  shipments        Shipment[]
  tracking         DeliveryTracking[]
  returns          ReturnRequest[]
  refund           Refund?
  SellerCommission SellerCommission[]

  @@index([userId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([paymentMethod])
  @@index([shortId])
}

model OrderItem {
  id        String          @id @default(uuid())
  orderId   String
  order     Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product         @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  title     String
  image     String
  quantity  Int
  price     Float
  mrp       Float
  status    OrderStatus     @default(PLACED)

  @@index([orderId])
  @@index([productId])
}

model OrderPayment {
  id             String        @id @default(uuid())
  orderId        String        @unique
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method         PaymentMethod
  status         PaymentStatus
  gateway        String
  gatewayRef     String?
  amount         Float
  refundedAmount Float         @default(0)
  payload        Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
}

model OrderStatusHistory {
  id        String      @id @default(uuid())
  orderId   String
  status    OrderStatus
  note      String?
  byUserId  String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

model Shipment {
  id            String           @id @default(uuid())
  orderId       String
  order         Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  partnerId     String?
  partner       DeliveryPartner? @relation(fields: [partnerId], references: [id])
  agentId       String?
  agent         DeliveryAgent?   @relation(fields: [agentId], references: [id])
  trackingId    String           @unique
  status        ShipmentStatus   @default(CREATED)
  deliveryStatus DeliveryStatus?
  fromAddress   Json
  toAddress     Json
  weight        Float?
  cost          Float            @default(0)
  pickedAt      DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  tracking      DeliveryTracking[]
  ShipmentEvent ShipmentEvent[]

  @@index([orderId])
  @@index([partnerId])
  @@index([agentId])
  @@index([deliveryStatus])
}

model DeliveryPartner {
  id        String   @id @default(uuid())
  name      String
  mobile    String?
  email     String?
  rating    Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  shipments Shipment[]
}

model DeliveryTracking {
  id         String   @id @default(uuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  lat        Float?
  lng        Float?
  status     String
  message    String?
  at         DateTime @default(now())

  @@index([shipmentId])
  @@index([orderId])
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  title     String?
  body      String
  verified  Boolean  @default(false)
  helpful   Int      @default(0)
  reported  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  media ReviewMedia[]

  @@unique([productId, userId])
  @@index([productId])
  @@index([rating])
}

model ReviewMedia {
  id        String   @id @default(uuid())
  reviewId  String
  review    Review   @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  url       String
  type      String
  createdAt DateTime @default(now())

  @@index([reviewId])
}

// ============================================================================
// RETURNS / REFUNDS
// ============================================================================

model ReturnRequest {
  id         String       @id @default(uuid())
  orderId    String
  order      Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  sellerId   String?
  seller     Seller?      @relation("SellerReturnRequests", fields: [sellerId], references: [id])
  reason     String
  type       String
  status     ReturnStatus @default(REQUESTED)
  notes      String?
  adminNotes String?
  pickupAt   DateTime?
  reviewedAt DateTime?
  refundId   String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  refund Refund?
  items  ReturnItem[]

  @@index([orderId])
  @@index([userId])
  @@index([sellerId])
  @@index([status])
}

model Refund {
  id          String         @id @default(uuid())
  orderId     String         @unique
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId      String
  user        User           @relation(fields: [userId], references: [id])
  returnId    String?        @unique
  return      ReturnRequest? @relation(fields: [returnId], references: [id])
  amount      Float
  status      RefundStatus   @default(INITIATED)
  reference   String?
  gatewayRef  String?
  reason      String?
  processedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([userId])
  @@index([status])
}

// ============================================================================
// NOTIFICATIONS / BANNERS / OFFERS / SEARCH HISTORY
// ============================================================================

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  image     String?
  link      String?
  read      Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
}

model Banner {
  id             String     @id @default(uuid())
  title          String
  subtitle       String?
  image          String
  mobileImage    String?
  bg             String     @default("#1d47f5")
  fg             String     @default("#ffffff")
  ctaLabel       String?
  ctaLink        String?
  ctaText        String?
  ctaUrl         String?
  link           String?
  type           BannerType @default(HOME)
  position       Int        @default(0)
  sortOrder      Int        @default(0)
  isActive       Boolean    @default(true)
  startsAt       DateTime?
  endsAt         DateTime?
  startAt        DateTime?
  endAt          DateTime?
  categoryId     String?
  productId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isActive, position])
  @@index([isActive, sortOrder])
  @@index([type])
  @@index([startsAt, endsAt])
  @@index([startAt, endAt])
}

model Offer {
  id          String    @id @default(uuid())
  title       String
  description String?
  image       String?
  type        OfferType
  badge       String?
  discountPct Float?
