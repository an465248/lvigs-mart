{
  "name": "lvigs-mart-backend",
  "version": "1.0.0",
  "description": "LVIGS Mart - NestJS REST + WebSocket backend",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:firebase": "jest --testPathPattern=firebase --passWithNoTests",
