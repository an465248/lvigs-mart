# ============================================================
# LVIGS Mart — Production Environment Variables
# ============================================================
# Copy this file to .env.production and fill in values
# NEVER commit .env.production to git
# ============================================================

# --- Database (choose ONE: self-hosted OR Supabase) ---

# Option A: Self-hosted PostgreSQL (Docker)
POSTGRES_USER=lvigs
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=lvigs_mart
DATABASE_URL=postgresql://lvigs:CHANGE_ME_STRONG_PASSWORD@postgres:5432/lvigs_mart?schema=public
DIRECT_URL=postgresql://lvigs:CHANGE_ME_STRONG_PASSWORD@postgres:5432/lvigs_mart?schema=public

# Option B: Supabase (uncomment below, comment out Option A)
# DATABASE_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# DIRECT_URL=postgresql://postgres.PROJECT_REF:CHANGE_ME_DB_PASSWORD@aws-0-REGION.supabase.com:5432/postgres

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_STRONG_REDIS_PASSWORD@redis:6379

# --- Backend ---
NODE_ENV=production
PORT=4000
WEB_ORIGIN=https://YOUR_DOMAIN,https://www.YOUR_DOMAIN

# --- JWT (generate with: openssl rand -hex 32) ---
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHAR_STRING
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Firebase ---
FIREBASE_PROJECT_ID=lvigs-mart
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@lvigs-mart.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_ME\n-----END PRIVATE KEY-----\n"

# --- Razorpay ---
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# --- S3 Storage ---
S3_ENDPOINT=https://s3.ap-south-1.amazonaws.com
S3_REGION=ap-south-1
S3_BUCKET=lvigs-mart
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME

# --- OpenSearch ---
OPENSEARCH_URL=http://opensearch:9200

# --- Sentry ---
SENTRY_DSN=https://CHANGE_ME@sentry.io/CHANGE_ME
SENTRY_ENVIRONMENT=production

# --- AI ---
AI_PROVIDER=local
AI_API_KEY=
AI_MODEL=gpt-4
AI_TIMEOUT=30000
AI_MAX_TOKENS=1000

# --- Feature Flags ---
FEATURE_AI_ASSISTANT=true
FEATURE_VOICE_SEARCH=true
FEATURE_IMAGE_SEARCH=true
FEATURE_BARCODE_SEARCH=true
FEATURE_LOYALTY=true
FEATURE_MEMBERSHIP=true
FEATURE_REFERRALS=true
FEATURE_ANALYTICS=true
FEATURE_FRAUD_DETECTION=true

# --- Frontend (NEXT_PUBLIC_ vars are exposed to browser) ---
DOMAIN_NAME=YOUR_DOMAIN
NEXT_PUBLIC_API_BASE_URL=https://api.YOUR_DOMAIN
NEXT_PUBLIC_APP_NAME=LVIGS Mart
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
NEXT_PUBLIC_FIREBASE_API_KEY=CHANGE_ME
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=lvigs-mart.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=lvigs-mart
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=lvigs-mart.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=667501442669
NEXT_PUBLIC_FIREBASE_APP_ID=CHANGE_ME

# --- Monitoring ---
SENTRY_ENVIRONMENT=production

# --- Misc ---
DEFAULT_CURRENCY=INR
DEFAULT_LOCALE=en-IN
LOCAL_STORAGE_PATH=/opt/lvigs-mart/uploads
